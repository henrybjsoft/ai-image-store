# 服务器配置
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# 路径前缀配置（生产环境通过 nginx 反向代理时使用）
# 开发环境留空，生产环境设置如：/bj-images
BASE_URL=

# 时区配置（影响数据库时间存储和显示）
# 常见值: Asia/Shanghai, UTC, America/New_York, Europe/London
TZ=Asia/Shanghai

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL 数据库配置
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=image_asset
PG_USER=postgres
PG_PASSWORD=your_password

# 向量维度配置（根据 Embedding 模型设置）
# DashScope text-embedding-v3: 1024
# Ollama nomic-embed-text: 768
# Ollama mxbai-embed-large: 1024
EMBEDDING_DIMENSION=1024

# AI 提供商配置
# 可选值: dashscope, ollama
AI_PROVIDER=dashscope

# DashScope API 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_VISION_MODEL=qwen-vl-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# 文件上传配置
MAX_FILE_SIZE=10485760
MAX_FILES=100
UPLOAD_DIR=./uploads
UPLOAD_CONCURRENCY=5

# 缩略图配置
THUMBNAIL_SIZE=400
THUMBNAIL_QUALITY=80

# 允许的图片格式
ALLOWED_FORMATS=jpg,jpeg,png,webp,gif,svg

# 存储配置
# 可选值: local, minio
STORAGE_TYPE=local

# 本地存储配置
LOCAL_STORAGE_DIR=./uploads
LOCAL_STORAGE_BASE_URL=/uploads

# MinIO 存储配置
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=images
MINIO_PUBLIC_URL=http://localhost:9000/images